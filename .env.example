# Required for live photo analysis
OPENAI_API_KEY=

# Optional overrides
OPENAI_MODEL=gpt-5.4-mini
# Set to 1 only while diagnosing recognition in the server console
SKU_DIAGNOSTICS=0
# USD per 1M tokens. Leave all three blank to use the built-in standard
# gpt-5.4-mini rates: 0.75 input, 0.075 cached input, and 4.50 output.
# Set all three when overriding the model or using regional pricing.
PRICE_INPUT_PER_MILLION=
PRICE_CACHED_PER_MILLION=
PRICE_OUTPUT_PER_MILLION=
